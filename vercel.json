{
  "version": 2,
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.3"
    },
    "api/**/*.php": {
      "runtime": "vercel-php@0.7.3"
    },
    "backend/**/*.php": {
      "runtime": "vercel-php@0.7.3"
    },
    "backend/*.php": {
      "runtime": "vercel-php@0.7.3"
    },
    "*.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "rewrites": [
    {
      "source": "/assets/(.*)",
      "destination": "/backend/assets/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/backend/uploads/$1"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/backend/auth/$1"
    },
    {
      "source": "/modules/(.*)",
      "destination": "/backend/modules/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/backend/api/$1"
    },
    {
      "source": "/backend/(.*)",
      "destination": "/backend/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.php"
    }
  ]
}
