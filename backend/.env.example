# ==============================================================================
# BOOK BANKO - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual credentials
# ==============================================================================

# Database Driver: 'pgsql' (Supabase PostgreSQL) or 'mysql' (Local MySQL fallback)
DB_DRIVER=pgsql

# Supabase Direct PostgreSQL Connection Settings
SUPABASE_DB_HOST=aws-0-ap-northeast-1.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=your_supabase_db_user
SUPABASE_DB_PASSWORD=your_supabase_db_password
SUPABASE_DB_SSLMODE=require

# Supabase REST & Storage API Settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Supabase Storage Buckets
SUPABASE_STORAGE_BUCKET_PDFS=pdfs
SUPABASE_STORAGE_BUCKET_BANNERS=banners
SUPABASE_STORAGE_BUCKET_ICONS=icons
SUPABASE_STORAGE_BUCKET_PRODUCTS=products

# Legacy MySQL Local Fallback
MYSQL_DB_HOST=localhost
MYSQL_DB_PORT=3306
MYSQL_DB_NAME=book_banko_db
MYSQL_DB_USER=root
MYSQL_DB_PASS=
